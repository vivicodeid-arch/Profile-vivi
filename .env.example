# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://vividev:vividev_dev_password@localhost:5432/vividev

# Redis
REDIS_URL=redis://localhost:6379

# JWT (ganti dengan string random min 32 karakter)
JWT_SECRET=change-this-to-random-string-min-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-random-string-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Email SMTP
SMTP_HOST=mx3.mailspace.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@vividev.id
SMTP_PASS=your-smtp-password
CONTACT_EMAIL_TO=support@vividev.id

# WhatsApp
WA_NUMBER=6285798112370

# Upload
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# Seed — password untuk admin user awal, WAJIB diset sebelum menjalankan db:seed
# Gunakan password yang kuat dan JANGAN commit nilai aslinya ke repo
ADMIN_SEED_PASSWORD=change-this-to-a-strong-admin-password
